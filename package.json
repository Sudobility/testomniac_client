{
  "name": "@sudobility/testomniac_client",
  "version": "0.0.139",
  "description": "Testomniac API client library with TanStack Query hooks",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json",
    "build:watch": "bunx tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "sh -c 'test ! -f ../workflows/scripts/check-publish-safety.cjs || node ../workflows/scripts/check-publish-safety.cjs' && bun run clean && bun run build",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint src/",
    "lint:fix": "bunx eslint src/ --fix",
    "format": "bunx prettier --write \"src/**/*.ts\"",
    "format:check": "bunx prettier --check \"src/**/*.ts\"",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build"
  },
  "keywords": [
    "testomniac",
    "client",
    "react",
    "typescript",
    "tanstack-query"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@sudobility/di": "^1.5.79",
    "@sudobility/testomniac_types": "^0.0.115",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": "~5.104.5",
    "@types/react": "~19.3.0",
    "react": "~19.3.1",
    "@eslint/js": "~9.39.5",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "globals": "~16.5.0",
    "prettier": "~3.9.10",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/testomniac_client.git"
  }
}
